// wind_service.gatt
// BLE GATT definitions for restreaming Calypso anemometer data
// Uses standard Bluetooth SIG UUIDs

// === GAP Service ===
PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "KHAMOSAYEE"

// === GATT Service ===
PRIMARY_SERVICE, GATT_SERVICE

// === Environmental Sensing Service (0x181A) ===
PRIMARY_SERVICE, 0x181A

// Apparent Wind Speed (0x2A72) — uint16, 0.01 m/s resolution
// READ: poll current value | NOTIFY: push on update
CHARACTERISTIC, 0x2A72, READ | NOTIFY | DYNAMIC,

// Apparent Wind Direction (0x2A73) — uint16, 0.01 degrees resolution
CHARACTERISTIC, 0x2A73, READ | NOTIFY | DYNAMIC,

// === Battery Service (0x180F) ===
PRIMARY_SERVICE, 0x180F

// Battery Level (0x2A19) — uint8, 0-100%
CHARACTERISTIC, 0x2A19, READ | NOTIFY | DYNAMIC,

// === Location and Navigation Service (0x1819) ===
PRIMARY_SERVICE, 0x1819

// Latitude (0x2A69) — int32, 1e-7 degrees
CHARACTERISTIC, 0x2A69, READ | NOTIFY | DYNAMIC,

// Longitude (0x2A6A) — int32, 1e-7 degrees
CHARACTERISTIC, 0x2A6A, READ | NOTIFY | DYNAMIC,

// Altitude (0x2A6B) — int32, millimeters
CHARACTERISTIC, 0x2A6B, READ | NOTIFY | DYNAMIC,

// Heading (0..359.99 degrees)
CHARACTERISTIC, 0xFFF5, READ | NOTIFY | DYNAMIC,

// GPS accuracy (horizontal, 0.01 m)
CHARACTERISTIC, 0xFFF6, READ | NOTIFY | DYNAMIC,

// === Manual Control Service (0xFFF0) ===
PRIMARY_SERVICE, 0xFFF0

// Control mode (0 = automatic, 1 = manual)
CHARACTERISTIC, 0xFFF1, READ | WRITE | DYNAMIC,

// Front wheel steering offset in degrees relative to center (-45..45)
CHARACTERISTIC, 0xFFF2, READ | WRITE | DYNAMIC,

// Sail opening percentage (0..100)
CHARACTERISTIC, 0xFFF3, READ | WRITE | DYNAMIC,

// Target waypoint as latitude/longitude in 1e-7 degrees (8 bytes, little-endian)
CHARACTERISTIC, 0xFFF4, WRITE | DYNAMIC,
